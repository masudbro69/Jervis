# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Keystore files (do not commit signing keys)
*.jks
*.keystore
debug.keystore

# Google Services (auto-generated)
google-services.json

# Environment variables (secrets)
.env

# Secrets Gradle Plugin
secrets.properties

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# Firebase
.firebase/

# Node (if using any JS tooling)
node_modules/
npm-debug.log*

# Kotlin
*.kotlin_module

# Roborazzi screenshots (generated test artifacts)
app/src/test/screenshots/

# AI Studio assets (local)
assets/.aistudio/

# Compiled output
/app/build/
